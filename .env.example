# ── Meta (Messenger + Instagram apps-integration) ────────────────────────────
# One Meta Developer App shared across every connected company — per-company
# credentials live encrypted in Mongo, not here. See
# backend/model/apps_integration_model.py and
# backend/services/apps_integration/.

# Meta App → Settings → Basic
META_APP_ID=
META_APP_SECRET=

# Graph API version used for every Meta call in this integration
META_GRAPH_API_VERSION=v21.0

# A random string you invent yourself (not from Meta) — must match what you
# type into Meta's Webhooks "Verify Token" field. Generate with:
#   openssl rand -hex 20
META_WEBHOOK_VERIFY_TOKEN=

# Where Meta redirects the browser after the OAuth consent dialog
# (/apps-integration/oauth/callback) — must exactly match a Valid OAuth
# Redirect URI configured on the Meta App.
META_OAUTH_REDIRECT_URI=http://localhost:8000/api/apps-integration/oauth/callback

# AES-256-GCM key for encrypting connected channels' access tokens at rest
# (backend/utils/token_encryption.py). Must be 64 hex characters (32 raw
# bytes). Generate with:
#   openssl rand -hex 32
# Losing or rotating this makes every already-stored token undecryptable —
# back it up somewhere durable, separate from this .env file.
TOKEN_ENCRYPTION_KEY=
